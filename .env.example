# Export these settings in the shell before running scripts/run-demo.sh.
FAIRBILL_PROFILE=local
FAIRBILL_BIND=127.0.0.1
FAIRBILL_PORT=8765
# Defaults to .local/fairbill.sqlite3 and .local/originals.
# FAIRBILL_DB=/absolute/path/to/cases.sqlite3
# FAIRBILL_DOCUMENT_STORE=/absolute/path/to/originals

# Local-only optional integrations. Leave both Gemini settings unset for offline operation.
# GEMINI_API_KEY=
# FAIRBILL_GEMINI_MODEL=
# FAIRBILL_CORS_ORIGINS=http://localhost:8081

# Hosted testing profile. Provision a separate store and set its invite on the server.
# FAIRBILL_PROFILE=fixtures
# FAIRBILL_INVITE_CODE=
# FAIRBILL_REQUESTS_PER_MINUTE=120

# Optional local overrides. Every reference file must declare fictional:true.
# FAIRBILL_RULES_FILE=/absolute/path/to/rules.json
# FAIRBILL_ASSISTANCE_FILE=/absolute/path/to/assistance.json
